# Copy to .env and adjust. Never commit .env (it is gitignored).

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Mounts /v1/test/* (clock advance, reset). Ignored when APP_ENV=production.
ENABLE_TEST_ROUTES=false

# PostgreSQL. docker-compose uses these to create the local database, and the app uses them to
# connect. Inside docker-compose, POSTGRES_HOST is overridden to "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=compliance
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=compliance
# Set to "require" for Lightsail managed PostgreSQL.
# POSTGRES_SSLMODE=require

# Alternatively, a full SQLAlchemy URL overrides all POSTGRES_* connection settings:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Host ports published by docker-compose (change if 5432/8000 are already in use).
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
