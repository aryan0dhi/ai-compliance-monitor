# Copy to .env and adjust. Never commit .env (it is gitignored).

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Mounts /v1/test/* (clock advance, reset) and switches the API and worker to the shared
# simulated clock. Ignored when APP_ENV=production. Set to true for cross-team test deployments.
ENABLE_TEST_ROUTES=false

# REQ-04 / REQ-02: maximum delay from detection to reviewer notification (seconds).
NOTIFY_MAX_DELAY_S=900
# How often the worker sweeps for gaps and delivers webhooks (must be < NOTIFY_MAX_DELAY_S).
WORKER_POLL_INTERVAL_S=5
# /healthz reports "worker": "stale" when the last heartbeat is older than this.
WORKER_STALE_AFTER_S=60
# Webhook delivery: per-request timeout and attempts before giving up.
WEBHOOK_TIMEOUT_S=5
WEBHOOK_MAX_ATTEMPTS=10
# Allow webhook URLs on localhost/private networks (local testing only; ignored in production,
# which also requires https).
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# PostgreSQL. docker-compose uses these to create the local database, and the app uses them to
# connect. Inside docker-compose, POSTGRES_HOST is overridden to "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=compliance
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=compliance
# Set to "require" for Lightsail managed PostgreSQL.
# POSTGRES_SSLMODE=require

# Alternatively, a full SQLAlchemy URL overrides all POSTGRES_* connection settings:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Host ports published by docker-compose (change if 5432/8000 are already in use).
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
