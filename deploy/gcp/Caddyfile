# HTTPS front for the API. SITE_ADDRESS is a hostname such as 34-1-2-3.sslip.io (deploy.sh sets
# it from the VM's static IP); Caddy obtains and renews the certificate itself.
{$SITE_ADDRESS} {
	encode gzip
	# Tester service (course testing interface); the prefix is stripped, so /tester/test/run
	# reaches the tester's /test/run.
	handle_path /tester/* {
		reverse_proxy tester:8100
	}
	handle {
		reverse_proxy api:8000
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
